# Thin update image: uses the published base, replaces only source.
# chatV2 branch: tutorbot-web/ runs as a separate container on port 3000;
# the legacy web/ frontend is not needed here, so we skip that build step.
# Avoids the full Rust/Python dependency build that is too heavy for a 2 GB server.
FROM ghcr.nju.edu.cn/hkuds/deeptutor:latest

ARG BACKEND_PORT=8001

# ── Install extra Python dependencies added on chatV2 ───────────────────────
RUN pip install --no-cache-dir redis --root-user-action=ignore

# ── Replace backend source ───────────────────────────────────────────────────
COPY deeptutor/ /app/deeptutor/
